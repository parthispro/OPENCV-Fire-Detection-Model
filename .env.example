# Flask
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# YOLO Model
MODEL_PATH=fire.pt

# SMTP / SendGrid
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key-here

# Email addresses
EMAIL_SENDER=your-sender-email@example.com
EMAIL_RECEIVER=your-receiver-email@example.com

# Alarm
ALARM_FILE=firealarm.mp3

# Detection
CONFIDENCE_THRESHOLD=50

# Location
GPS_LOCATION=https://maps.app.goo.gl/DP8jKnojixhz1j4q6
